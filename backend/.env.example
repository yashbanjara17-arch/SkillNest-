# SkillNest Backend — Environment Configuration
# Copy this file to .env and fill in the actual values
# NEVER commit .env to version control

# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://skillnest_app:YOUR_DB_PASSWORD_HERE@localhost:5432/skillnest_db"

# ── Session ───────────────────────────────────────────────────────────────────
# A long random secret for signing session cookies (generate with: openssl rand -hex 32)
SESSION_SECRET="replace-with-a-long-random-secret-at-least-32-chars"

# ── Server ────────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ── Frontend URL (for CORS) ───────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
